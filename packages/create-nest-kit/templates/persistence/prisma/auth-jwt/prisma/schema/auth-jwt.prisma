/// The hash of each session's current refresh token; rotation compares and sets `token_hash`.
model SessionRefreshToken {
  sessionId String  @id @map("session_id") @db.Uuid
  tokenHash String  @map("token_hash")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_refresh_tokens")
}

model VerificationToken {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// `email_verification` or `password_reset` (VerificationPurpose).
  purpose   String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // By user and purpose to replace a user's tokens; by expiry for the daily purge.
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}
