// Ids are UUIDv7 strings generated by the repositories, so they have no default here.
// The repositories match the explicitly named (`map:`) constraints in database errors.

model Role {
  id          String     @id @db.Uuid
  name        String     @unique(map: "roles_name_key")
  description String
  /// Permission values; the repositories check them against the Permission enum.
  permissions String[]
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "user_roles_role_id_fkey")

  // The primary key serves lookups by user; deleting a role looks them up by role.
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}
